#!/usr/bin/env bash
# tmux-kube-context: Find kubeconfig files in ~/.kube/config.d/ and open them in tmux sessions

set -o pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-kube-context"
CONFIG_FILE="$CONFIG_DIR/config"
KUBE_CONFIG_DIR="$HOME/.kube/config.d"

# Default startup hook command (can be overridden in config)
STARTUP_HOOK=""

# Check for required dependencies
check_dependencies() {
    local missing=()
    
    for cmd in fzf tmux; do
        if ! command -v "$cmd" &> /dev/null; then
            missing+=("$cmd")
        fi
    done
    
    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "Error: Missing required dependencies: ${missing[*]}" >&2
        exit 1
    fi
}

# Load configuration
load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$CONFIG_FILE"
    fi
}

# Find all kubeconfig files in ~/.kube/config.d/
find_kube_configs() {
    if [[ -d "$KUBE_CONFIG_DIR" ]]; then
        # Find all files (non-directories) in the config directory
        find "$KUBE_CONFIG_DIR" -maxdepth 1 -type f 2>/dev/null
    fi
}

# Format kubeconfig path for display (show only filename)
format_for_display() {
    while IFS= read -r path; do
        basename "$path"
    done
}

# Generate a tmux-compatible session name from a filename
# Replaces dots with underscores and other special characters with underscores
# This ensures tmux session names are valid
generate_session_name() {
    local filename="$1"
    # Replace dots with underscores, then replace any non-alphanumeric chars (except dash and underscore)
    local sanitized
    sanitized=$(echo "$filename" | sed 's/\./_/g; s/[^a-zA-Z0-9_-]/_/g')
    echo "[KUBERNETES]_${sanitized}"
}

# Switch to an existing tmux session or attach if not in tmux
switch_to_session() {
    local session_name="$1"
    if [[ -n "$TMUX" ]]; then
        tmux switch-client -t "$session_name"
    else
        tmux attach-session -t "$session_name"
    fi
}

# Create or switch to tmux session for the selected kubeconfig
open_session() {
    local selected_filename="$1"
    
    if [[ -z "$selected_filename" ]]; then
        exit 0
    fi
    
    # Construct the full path
    local config_path="$KUBE_CONFIG_DIR/$selected_filename"
    
    # Generate session name
    local session_name
    session_name=$(generate_session_name "$selected_filename")
    
    # Check if session already exists
    if tmux has-session -t="$session_name" 2>/dev/null; then
        # Session exists, switch to it
        switch_to_session "$session_name"
    else
        # Build the command to run in the new session
        local session_command="export KUBECONFIG='$config_path'"
        
        if [[ -n "$STARTUP_HOOK" ]]; then
            # Append startup hook command
            # Note: STARTUP_HOOK is executed as-is from the user's config file
            # Users are responsible for the security of their startup hook commands
            session_command="$session_command; $STARTUP_HOOK"
        else
            # Default: start a new shell
            # Note: \$SHELL is escaped so tmux evaluates it in the session context
            # This ensures the user's configured shell is used, not the current shell
            session_command="$session_command; exec \$SHELL"
        fi
        
        # Create new session
        tmux new-session -d -s "$session_name" -c "$HOME" "$session_command"
        
        # Switch to the new session
        switch_to_session "$session_name"
    fi
}

# Show help
show_help() {
    cat << EOF
tmux-kube-context - Find kubeconfig files and open them in tmux sessions

Usage: tmux-kube-context [OPTIONS]

Options:
    -h, --help      Show this help message
    -l, --list      List all kubeconfig files without opening

Configuration:
    Config file: $CONFIG_FILE
    Kubeconfig directory: $KUBE_CONFIG_DIR
    
    The config file allows you to configure:
    - STARTUP_HOOK: Optional command to run when creating a session (e.g., "nix-shell")

Example config:
    STARTUP_HOOK="nix-shell"

How it works:
    - Searches for files in ~/.kube/config.d/
    - Creates or switches to a tmux session for the selected kubeconfig
    - Session name is prefixed with [KUBERNETES] followed by the filename
    - Sets KUBECONFIG environment variable to the selected file path
    - Optionally runs a startup hook command (e.g., nix-shell)

Examples:
    tmux-kube-context              # Interactive kubeconfig selection
    tmux-kube-context --list       # List all kubeconfig files

EOF
}

# Main function
main() {
    load_config
    check_dependencies
    
    # Check if kubeconfig directory exists
    if [[ ! -d "$KUBE_CONFIG_DIR" ]]; then
        echo "Error: Kubeconfig directory not found: $KUBE_CONFIG_DIR" >&2
        echo "Please create the directory and add kubeconfig files." >&2
        exit 1
    fi
    
    # Stream kubeconfig files directly to fzf for dynamic population
    # No pre-counting - files appear in fzf as they are found
    local selected
    selected=$(find_kube_configs | \
               format_for_display | \
               fzf --tmux=center,100% --prompt="Select Kubernetes config: ")
    
    open_session "$selected"
}

# Parse command line arguments
case "${1:-}" in
    -h|--help)
        show_help
        exit 0
        ;;
    -l|--list)
        load_config
        find_kube_configs | format_for_display
        exit 0
        ;;
    "")
        main
        ;;
    *)
        echo "Error: Unknown option: $1" >&2
        show_help
        exit 1
        ;;
esac
